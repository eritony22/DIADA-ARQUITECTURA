# Base de datos Postgres (Neon). En Vercel: Storage -> Create Database ->
# Postgres; al conectarla se define DATABASE_URL automáticamente.
DATABASE_URL=

# Acceso a la herramienta
ADMIN_USERNAME=admin

# Hash bcrypt de la contraseña. Genéralo con:
#   npm run hash-password -- "TU_CONTRASEÑA"
# En .env.local escapa cada "$" como "\$" (Next.js expande $variables).
# En el panel de Vercel se pega tal cual, sin escapar.
ADMIN_PASSWORD_HASH=

# Secreto para firmar la sesión. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
