# Base de datos Postgres (proyectos, configuración, mensajes).
# En Vercel: pestaña "Storage" del proyecto -> "Create Database" -> Postgres
# (Neon). Al conectarla, Vercel define DATABASE_URL automáticamente en las
# variables de entorno del proyecto — no necesitas copiarla a mano ahí.
# Para desarrollo local, copia la cadena de conexión desde el dashboard
# (Storage -> tu base de datos -> pestaña ".env.local").
DATABASE_URL=

# Almacenamiento de imágenes subidas desde el panel (/admin).
# En Vercel: pestaña "Storage" -> "Create Database" -> Blob. Igual que con
# Postgres, Vercel define BLOB_READ_WRITE_TOKEN automáticamente en producción.
# Para desarrollo local, copia el token desde el dashboard del store de Blob.
BLOB_READ_WRITE_TOKEN=

# Credenciales del panel de administración (/admin)
ADMIN_USERNAME=admin

# Hash bcrypt de la contraseña del panel. Genera uno nuevo con:
#   node -e "console.log(require('bcryptjs').hashSync('TU_CONTRASEÑA', 10))"
#
# IMPORTANTE: el hash empieza con $2b$10$... — Next.js expande $variables
# al leer archivos .env, así que debes ESCAPAR cada "$" como "\$" al
# pegarlo aquí (o el hash quedará truncado y el login fallará). Ejemplo:
#   ADMIN_PASSWORD_HASH=\$2b\$10\$ZbusTASNYbh9D99iLDMkLuN4sXCpL8jBQ.6FTRT0qwwLl6G5MJ7Z2
ADMIN_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión del panel (cadena aleatoria larga).
# Genera uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
